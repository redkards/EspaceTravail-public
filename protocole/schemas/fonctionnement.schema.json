{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocole.nexus.redkards.local/v1/fonctionnement.schema.json",
  "title": "Réponse /api/fonctionnement",
  "description": "Grille des niveaux F1..F4 et consommation du mois par niveau appliqué.",
  "type": "object",
  "required": [
    "defaut",
    "niveaux",
    "mois",
    "consommation"
  ],
  "properties": {
    "defaut": {
      "$ref": "commun.schema.json#/$defs/fonctionnement"
    },
    "niveaux": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "nom",
          "fournisseur",
          "budget_tokens",
          "revisions_max",
          "double_controle",
          "delai_max_s",
          "cout_max_eur"
        ],
        "properties": {
          "code": {
            "$ref": "commun.schema.json#/$defs/fonctionnement"
          },
          "nom": {
            "type": "string"
          },
          "effort": {
            "type": "string"
          },
          "fournisseur": {
            "type": "string",
            "x-valeurs-connues": [
              "ollama_local",
              "courant",
              "anthropic"
            ]
          },
          "budget_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "revisions_max": {
            "type": "integer",
            "minimum": 0
          },
          "double_controle": {
            "type": "boolean"
          },
          "llm_max_chars": {
            "type": "integer",
            "minimum": 0
          },
          "num_ctx": {
            "type": "integer",
            "minimum": 0
          },
          "delai_max_s": {
            "type": "number",
            "minimum": 0
          },
          "cout_max_eur": {
            "type": "number",
            "minimum": 0
          },
          "modeles": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "tarifs_usd_par_mtok": {
      "type": "object"
    },
    "eur_par_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "estimation_f4": {
      "type": "object"
    },
    "f4_indisponible": {
      "type": [
        "string",
        "null"
      ]
    },
    "mois": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "consommation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "missions",
          "tokens",
          "cout_eur"
        ],
        "properties": {
          "code": {
            "$ref": "commun.schema.json#/$defs/fonctionnement"
          },
          "missions": {
            "type": "integer",
            "minimum": 0
          },
          "tokens": {
            "type": "integer",
            "minimum": 0
          },
          "tokens_entree": {
            "type": "integer",
            "minimum": 0
          },
          "tokens_sortie": {
            "type": "integer",
            "minimum": 0
          },
          "cout_eur": {
            "type": "number",
            "minimum": 0
          },
          "duree_moyenne_s": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}
