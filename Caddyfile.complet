# =============================================================================
#  Caddyfile.complet — Mini NEXUS MOTHERSHIP, MODE COMPLET (cockpit + n8n + Kuma + ntfy)
#  Les valeurs {$...} et {env.…} viennent des variables d'environnement du conteneur
#  caddy (elles-mêmes lues dans .env par docker compose).
#  HTTPS automatique Let's Encrypt sur le nom d'hôte du VPS.
#  Le site :443 applique exactement les mêmes règles que Caddyfile.mvp.
# =============================================================================
{
	email {$ACME_EMAIL}
	# Journal général (erreurs, certificats) : l'adresse /mcp/<jeton> est masquée
	# et les en-têtes secrets supprimés, même dans les messages d'erreur.
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri regexp ^/mcp.* /mcp/***
				request>headers>X-Nexus-Key delete
				request>headers>X-Cockpit-Auth delete
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}

# En-têtes de sécurité (tous les sites) : pas d'affichage dans un cadre, pas de
# fuite d'adresse vers d'autres sites, HTTPS imposé pendant un an.
(securite) {
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# Journal d'accès : l'adresse des requêtes /mcp/* (qui contient le jeton d'une IA)
# n'est JAMAIS écrite (remplacée par /mcp/***) ; clés et mots de passe supprimés.
(journal) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp ^/mcp.* /mcp/***
				request>headers>X-Nexus-Key delete
				request>headers>X-Cockpit-Auth delete
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}

# --- Cockpit + API nexus-core + passerelle nexus-bridge (port 443) ----------
{$NEXUS_HOST} {
	import securite
	import journal
	encode gzip

	# Les en-têtes X-Cockpit-Auth et X-Cockpit-Utilisateur envoyés par un visiteur sont
	# TOUJOURS supprimés : seul Caddy les ajoute, après le mot de passe, sur /cockpit*.
	request_header -X-Cockpit-Auth
	request_header -X-Cockpit-Utilisateur

	# Passerelle MCP Claude · ChatGPT · Gemini (nexus-bridge) : SANS basic auth,
	# protégée par un jeton secret par IA (/mcp/<jeton> ou « Authorization: Bearer »).
	@mcp path /mcp /mcp/*
	handle @mcp {
		request_body {
			max_size 128KB
		}
		reverse_proxy nexus-bridge:8000
	}

	# Page de suivi de la passerelle (lecture seule, mot de passe du cockpit)
	@bridge path /bridge /bridge/*
	handle @bridge {
		basic_auth {
			{$COCKPIT_USER} {$COCKPIT_PASSWORD_HASH}
		}
		reverse_proxy nexus-bridge:8000
	}

	# Cockpit : mot de passe (basic auth), PUIS en-tête interne secret attendu par
	# nexus-core (COCKPIT_INTERNAL, généré par install.sh). Couvre aussi le cockpit
	# installable : /cockpit/manifest.webmanifest, /cockpit/sw.js, /cockpit/icones/*,
	# /cockpit/hors-ligne. L'en-tête de réponse Service-Worker-Allowed (scope /cockpit/)
	# envoyé par nexus-core n'est jamais retiré par Caddy.
	@cockpit path /cockpit /cockpit/*
	handle @cockpit {
		basic_auth {
			{$COCKPIT_USER} {$COCKPIT_PASSWORD_HASH}
		}
		request_header X-Cockpit-Auth {env.COCKPIT_INTERNAL}
		reverse_proxy nexus-core:8000 {
			# Identifiant validé par le basic auth (journal des décisions)
			header_up X-Cockpit-Utilisateur {http.auth.user.id}
		}
	}

	# API /api/* : sans mot de passe Caddy, nexus-core exige l'en-tête X-Nexus-Key.
	handle {
		reverse_proxy nexus-core:8000
	}
}

# --- n8n (port 8443) : mot de passe Caddy EN PLUS du compte n8n -------------
# Les webhooks (/webhook/...) demandent aussi ce mot de passe :
#   curl -u UTILISATEUR:MOT_DE_PASSE https://HOTE:8443/webhook/nexus-mission ...
{$NEXUS_HOST}:8443 {
	import securite
	import journal
	basic_auth {
		{$N8N_BASIC_USER} {$N8N_BASIC_PASSWORD_HASH}
	}
	reverse_proxy n8n:5678
}

# --- Uptime Kuma (port 8444) ------------------------------------------------
# Protégé par les identifiants du cockpit (évite qu'un inconnu crée le compte admin).
{$NEXUS_HOST}:8444 {
	import securite
	import journal
	basic_auth {
		{$COCKPIT_USER} {$COCKPIT_PASSWORD_HASH}
	}
	reverse_proxy uptime-kuma:3001
}

# --- ntfy (port 8445) : notifications ---------------------------------------
# Accès refusé par défaut (NTFY_AUTH_DEFAULT_ACCESS=deny-all) : seul le sujet
# NTFY_TOPIC est ouvert, en ÉCRITURE seule pour l'anonyme (nexus-core, n8n) et en
# LECTURE pour le compte NTFY_USER créé par install.sh (appli Android).
{$NEXUS_HOST}:8445 {
	import securite
	import journal
	reverse_proxy ntfy:80
}
