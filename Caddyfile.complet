# =============================================================================
#  Caddyfile.complet — Mini NEXUS MOTHERSHIP, MODE COMPLET (cockpit + n8n + Kuma + ntfy)
#  Les valeurs {$...} viennent des variables d'environnement du conteneur caddy
#  (elles-mêmes lues dans .env par docker compose).
#  HTTPS automatique Let's Encrypt sur le nom d'hôte du VPS.
# =============================================================================
{
	email {$ACME_EMAIL}
}

# En-têtes de sécurité communs
(securite) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# --- Cockpit + API nexus-core + passerelle nexus-bridge (port 443) ----------
{$NEXUS_HOST} {
	import securite
	encode gzip

	# Cockpit ET page /bridge protégés par mot de passe (basic auth).
	# L'API /api/* passe sans mot de passe Caddy : nexus-core exige l'en-tête X-Nexus-Key.
	@protege path /cockpit /cockpit/* /bridge /bridge/*
	basic_auth @protege {
		{$COCKPIT_USER} {$COCKPIT_PASSWORD_HASH}
	}

	# Passerelle MCP Claude · ChatGPT · Gemini (nexus-bridge) : SANS basic auth,
	# protégée par un jeton secret par IA (/mcp/<jeton> ou « Authorization: Bearer »).
	# Aucun journal d'accès Caddy n'est activé : le jeton du chemin n'est pas enregistré.
	@mcp path /mcp /mcp/*
	handle @mcp {
		request_body {
			max_size 128KB
		}
		reverse_proxy nexus-bridge:8000
	}

	# Page de suivi de la passerelle (lecture seule, mot de passe du cockpit)
	@bridge path /bridge /bridge/*
	handle @bridge {
		reverse_proxy nexus-bridge:8000
	}

	handle {
		reverse_proxy nexus-core:8000
	}
}

# --- n8n (port 8443) : mot de passe Caddy EN PLUS du compte n8n -------------
# Les webhooks (/webhook/...) demandent aussi ce mot de passe :
#   curl -u UTILISATEUR:MOT_DE_PASSE https://HOTE:8443/webhook/nexus-mission ...
{$NEXUS_HOST}:8443 {
	import securite
	basic_auth {
		{$N8N_BASIC_USER} {$N8N_BASIC_PASSWORD_HASH}
	}
	reverse_proxy n8n:5678
}

# --- Uptime Kuma (port 8444) ------------------------------------------------
# Protégé par les identifiants du cockpit (évite qu'un inconnu crée le compte admin).
{$NEXUS_HOST}:8444 {
	import securite
	basic_auth {
		{$COCKPIT_USER} {$COCKPIT_PASSWORD_HASH}
	}
	reverse_proxy uptime-kuma:3001
}

# --- ntfy (port 8445) : notifications ---------------------------------------
# Pas de mot de passe : le nom du topic (aléatoire) fait office de secret.
{$NEXUS_HOST}:8445 {
	import securite
	reverse_proxy ntfy:80
}
