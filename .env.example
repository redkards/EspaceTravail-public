# =============================================================================
#  .env.example — modèle des variables du Mini NEXUS MOTHERSHIP
#  NE PAS remplir à la main : install.sh crée automatiquement « .env »
#  avec des secrets aléatoires. Ce fichier ne contient AUCUN secret.
#
#  IMPORTANT (hash bcrypt) : les hash commencent par « $2a$14$... ».
#  Ils doivent rester entre APOSTROPHES simples dans .env, sinon docker compose
#  tenterait d'interpréter les « $ » comme des variables.
#    Exemple :  COCKPIT_PASSWORD_HASH='$2a$14$abc...'
# =============================================================================

# --- Accès public -----------------------------------------------------------
COMPOSE_PROJECT_NAME=p1-nexus
NEXUS_HOST=srvXXXX.hstgr.cloud
ACME_EMAIL=vous@exemple.fr

# --- PostgreSQL (mode complet uniquement ; le MVP utilise SQLite) ------------
POSTGRES_USER=nexus
POSTGRES_PASSWORD=
POSTGRES_DB=nexus
# Construite automatiquement dans docker-compose.yml (pour information) :
DATABASE_URL=postgresql+psycopg://nexus:MOT_DE_PASSE_POSTGRES@postgres:5432/nexus

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- nexus-core / cockpit ---------------------------------------------------
NEXUS_API_KEY=
COCKPIT_USER=decideur
COCKPIT_PASSWORD=
COCKPIT_PASSWORD_HASH=''
# Secret interne (64 hex) : Caddy l'ajoute en en-tête X-Cockpit-Auth sur /cockpit*
# après le mot de passe ; nexus-core refuse le cockpit sans lui.
COCKPIT_INTERNAL=
# Clé HMAC (64 hex) qui scelle le journal LEDGER
LEDGER_HMAC_KEY=
# Nombre de missions traitées en parallèle (vide = automatique)
NEXUS_MAX_MISSIONS=
# Décideur mobile (/cockpit/decideur) : code à 6 chiffres (généré une fois par install.sh)
# exigé pour valider une décision à risque élevé. Voir : grep COCKPIT_CODE_DECIDEUR .env
COCKPIT_CODE_DECIDEUR=
# Heures de présentation groupée des décisions N3 (Europe/Paris)
NEXUS_SESSIONS_N3=12:30,19:00
# Mémoire par projet : 1 = résumé automatique après chaque mission ; 0 = désactivé
NEXUS_MEMOIRE_AUTO=1
# Dossier des connaissances dans le conteneur (./projets et ./tests-poker/contexte, lecture seule)
NEXUS_CONNAISSANCES_DIR=/connaissances

# --- Décisions, mémoire collective, banc, pilote (V2) -------------------------
# Les décisions N3 se prennent UNIQUEMENT dans le cockpit. 1 = l'API peut décider : TESTS UNIQUEMENT.
NEXUS_API_PEUT_DECIDER=0
# Au-delà de ce montant, une décision est « à risque élevé » (code Décideur exigé)
NEXUS_SEUIL_RISQUE_ELEVE_EUR=1000
# Modèle par rôle (ex. analyst=gemma4:31b,checker=qwen3:8b) et modèles cloud autorisés (vide = défaut)
NEXUS_MODELES_ROLES=
NEXUS_MODELES_CLOUD=
# Heure du résumé quotidien
NEXUS_RESUME_QUOTIDIEN=19:00
# Export vers le QG : URL du webhook (vide = désactivé) et secret HMAC (généré par install.sh)
NEXUS_WEBHOOK_QG=
NEXUS_WEBHOOK_SECRET=
# Mémoire collective : exemples retenus après N bonnes notes ; leçons après N erreurs répétées,
# mesurées sur au moins N missions, suspendues si la qualité baisse de plus de N % ;
# 1 = proposer une reformulation automatique des consignes
NEXUS_EXEMPLES_SEUIL=4
NEXUS_LECONS_SEUIL=3
NEXUS_LECONS_MESURES_MIN=3
NEXUS_LECONS_BAISSE=10
NEXUS_LECONS_REFORMULER=0
NEXUS_ARCHIVE_DIR=/data/archive
# Banc d'essai (montés en lecture seule)
NEXUS_BANC_RESULTATS=/banc/tableau.json
NEXUS_BANC_DIR=/banc-essai
# Part des livrables proposés à la « note en un geste » (0.2 = 1 sur 5)
NEXUS_ECHANTILLON_NOTE=0.2
# Test fantôme : 1 mission terminée sur K est rejouée pour comparer
NEXUS_FANTOME_K=5
# Fenêtre de nuit (tâches lourdes) et heure du pilote hebdomadaire (lundi)
NEXUS_FENETRE_NUIT=01:00-06:00
NEXUS_PILOTE_HEBDO=07:30
# Dossier de chartes supplémentaire (facultatif ; /config/chartes est déjà monté)
NEXUS_CHARTES_DIR=
# Veille : contact ajouté au User-Agent du collecteur (page de contact, pas d'e-mail personnel)
VEILLE_CONTACT=

# --- Passerelle Claude · ChatGPT · Gemini (nexus-bridge) ----------------------
# Un jeton secret par IA (générés par install.sh). Le jeton identifie l'auteur de
# chaque écriture. Voir les URL à coller : bash bridge-connecteurs.sh
# Changer un jeton = supprimer sa ligne dans .env puis relancer install.sh.
BRIDGE_TOKEN_CLAUDE=
BRIDGE_TOKEN_CHATGPT=
BRIDGE_TOKEN_GEMINI=
# Jeton du propriétaire (vous) : peut archiver n'importe quelle mémoire
BRIDGE_TOKEN_PROPRIETAIRE=
# Limite de débit par jeton (appels par minute)
BRIDGE_LIMITE_PAR_MINUTE=60

# --- n8n --------------------------------------------------------------------
N8N_ENCRYPTION_KEY=
N8N_BASIC_USER=admin
N8N_BASIC_PASSWORD=
N8N_BASIC_PASSWORD_HASH=''

# --- Mode de déploiement (écrit par install.sh) -------------------------------
# Profils docker compose actifs : vide (MVP cloud seul), local, complet, complet,local
COMPOSE_PROFILES=local
# En mode complet seulement :
# COMPOSE_FILE=docker-compose.yml:docker-compose.complet.yml

# --- Modèle de langage ------------------------------------------------------
# ollama (IA locale, sans clé : défaut) | ollama_cloud (offre gratuite, si clé).
# install.sh choisit seul (ollama_cloud si une clé valide est fournie).
LLM_PROVIDER=ollama
# Modèle principal : qwen2.5:3b en local ; gemma4:31b avec Ollama Cloud
NEXUS_MODEL=qwen2.5:3b
# Modèle du CHECKER (vide = même modèle que NEXUS_MODEL)
NEXUS_MODEL_CHECKER=
OLLAMA_URL=http://ollama:11434
# Ollama Cloud : clé saisie par install.sh (jamais en argument). Ne la partagez pas.
OLLAMA_API_KEY=
OLLAMA_CLOUD_URL=https://ollama.com
# Repli si le fournisseur principal échoue : ollama (IA locale) | aucun
LLM_FALLBACK=ollama
# Modèle utilisé par l'IA locale (mode local ou repli)
NEXUS_MODEL_LOCAL=qwen2.5:3b

# --- Anthropic : PAYANT, DÉSACTIVÉ (jamais proposé par install.sh) -----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Garde-fous budget et décisions N3 ---------------------------------------
# Version gratuite : 0 = aucune dépense autorisée
BUDGET_MONTHLY_EUR=0
LLM_EUR_PAR_1K_TOKENS=0
BUDGET_TASK_TOKENS=20000
# Taille maximale (caractères) d'un message envoyé au modèle ; le CHECKER reçoit toujours le livrable entier
LLM_MAX_CHARS=12000
# Contexte du modèle local Ollama (tokens) ; 8192 pour lire des messages de 12 000 caractères
OLLAMA_NUM_CTX=8192
# Niveau de fonctionnement par défaut des missions (voir nexus-core/fonctionnement.yaml) :
#   F1 Éclair (local, 6 000 tokens) · F2 Standard · F3 Renforcé (double contrôle) · F4 Expert (Anthropic, payant)
# BUDGET_TASK_TOKENS, LLM_MAX_CHARS et OLLAMA_NUM_CTX ci-dessus servent de base au niveau F2.
NEXUS_FONCTIONNEMENT_DEFAUT=F2
# Conversion des tarifs Anthropic ($/million de tokens) en euros, utilisée par F4
EUR_PAR_USD=0.92
N3_TIMEOUT_HOURS=24
N3_DAILY_CAP=15

# --- Notifications ntfy (alertes N3 sur le téléphone, gratuit) ---------------
# MVP : service public ntfy.sh (tiers). Mode complet : serveur ntfy du kit (forcé
# à http://ntfy par docker-compose.complet.yml). Le texte reste générique.
NTFY_URL=https://ntfy.sh
# Sujet secret aléatoire « nexus-<16 hex> » généré par install.sh
NTFY_TOPIC=
# Mode complet seulement : compte de lecture pour l'appli Android (créé par install.sh)
NTFY_USER=proprietaire
NTFY_PASSWORD=

# --- Sauvegardes (backup.sh / restore.sh) -------------------------------------
# Phrase secrète (générée) qui chiffre env.sauvegarde avec gpg. NOTEZ-LA hors du VPS.
BACKUP_PASSPHRASE=
# Facultatif : clé publique age (age1...) ; si présente, age est utilisé à la place de gpg
BACKUP_AGE_RECIPIENT=
# Nom du « remote » rclone pour « backup.sh --hors-serveur » (configuré par vous)
NEXUS_RCLONE_REMOTE=gdrive

# Adresse IPv4 sur laquelle Caddy publie 80/443 (vide = détectée automatiquement)
NEXUS_BIND_IP=
