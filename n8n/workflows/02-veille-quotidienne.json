{
  "id": "NexusVeille00002",
  "name": "NEXUS — Veille quotidienne",
  "active": false,
  "nodes": [
    {
      "id": "43c70e4c-8b1d-48a4-87e1-f095ab2662d3",
      "name": "Chaque jour 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "6a1f3d2b-8c4e-4f90-ab32-d5e6f7080902",
      "name": "Paramètres",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "6a1f3d2b-8c4e-4f90-ab32-d5e6f7080901",
              "name": "nexus_core_url",
              "value": "http://nexus-core:8000",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "notes": "Valeurs NON secrètes à adapter : remplacez srvXXXX / nexus-XXXX par les vôtres (grep -E 'NEXUS_HOST|NTFY_TOPIC' .env). La clé API est dans l'identifiant n8n « NEXUS API » (Header Auth), jamais ici."
    },
    {
      "id": "ddad2595-7e73-41e8-afa5-049325e18e8e",
      "name": "Mission de veille",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Paramètres').first().json.nexus_core_url }}/api/missions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ titre: 'Veille quotidienne du ' + $now.setZone('Europe/Paris').toFormat('dd/LL/yyyy'), consigne: 'Synthétise la veille du jour à partir des textes fournis ci-dessous (aucun accès web). Liste ce qui manque. Textes : (à compléter dans n8n)', service: 'R&D-PARADOX/veille' }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "NexusApiCred0001",
          "name": "NEXUS API"
        }
      }
    }
  ],
  "connections": {
    "Chaque jour 08:00": {
      "main": [
        [
          {
            "node": "Paramètres",
