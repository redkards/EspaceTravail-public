            {
              "name": "Title",
              "value": "NEXUS - Rapport du soir"
            },
            {
              "name": "Tags",
              "value": "crescent_moon"
            },
            {
              "name": "Priority",
              "value": "={{ $json.en_attente > 0 ? 'high' : 'default' }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/plain; charset=utf-8",
        "body": "={{ $json.message }}",
        "options": {
          "timeout": 15000
        }
      }
    }
