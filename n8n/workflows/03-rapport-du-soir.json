    {
      "id": "e7f41c9a-f9e7-42b3-ae68-17663b33a022",
      "name": "Préparer le récapitulatif",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Assemble le récapitulatif (accepte une liste JSON ou un objet contenant une liste)\nfunction liste(nom) {\n  const items = $(nom).all().map(i => i.json);\n  if (items.length === 1) {\n    const j = items[0];\n    if (Array.isArray(j)) return j;\n    const tab = Object.values(j || {}).find(v => Array.isArray(v));\n    if (tab) return tab;\n    if (!j || Object.keys(j).length === 0) return [];\n  }\n  return items;\n}\nconst decisions = liste('Décisions en attente');\nconst missions = liste('Missions');\nconst parStatut = {};\nfor (const m of missions) { const s = m.statut || 'inconnu'; parStatut[s] = (parStatut[s] || 0) + 1; }\nlet txt = `Décisions N3 en attente : ${decisions.length}\\n`;\nfor (const d of decisions.slice(0, 5)) txt += `- #${d.id} ${(d.resume || '').toString().slice(0, 80)}\\n`;\ntxt += `\\nMissions (${missions.length}) : ` + (Object.entries(parStatut).map(([s, n]) => `${s}=${n}`).join(', ') || 'aucune');\ntxt += `\\n\\nOuvrir le cockpit : https://${$env.NEXUS_HOST || ''}/cockpit`;\nreturn [{ json: { message: txt, en_attente: decisions.length } }];"
      }
    },
    {
      "id": "9320f010-0a13-4e1f-be3f-26973f4db25f",
      "name": "Envoyer sur ntfy",
